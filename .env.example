# Copia este archivo a .env y pega tus propios connection strings de Neon.
# .env NUNCA se versiona (ver .gitignore) — cada integrante mantiene el suyo local.
#
# Cómo obtenerlos: Neon Console → tu proyecto → Dashboard → panel "Connection string".
# Selecciona la branch correspondiente en el desplegable antes de copiar.
# Formato URI, incluye ?sslmode=require al final.

# Branch de desarrollo — aquí es donde trabajas y pruebas todo localmente.
NEON_DEV_DATABASE_URL=postgresql://usuario:password@ep-xxxx-dev.us-east-2.aws.neon.tech/neondb?sslmode=require

# Branch principal — NUNCA se usa desde tu terminal salvo el bootstrap inicial documentado
# en el README. De ahí en adelante, solo el workflow de GitHub Actions la toca (vía Secret,
# no vía este archivo).
NEON_MAIN_DATABASE_URL=postgresql://usuario:password@ep-yyyy.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Snowflake — Momento 2, Punto 2 (ELT Neon -> Snowflake) --------------------------
# Setup como código en snowflake/setup/ (Punto 1). Detalle completo de cada variable en
# snowflake/setup/README.md.
#
# Autenticación por KEY-PAIR (RSA), NO por password: el usuario de servicio
# SVC_YELP_LOADER no tiene password configurado. Generar el par de llaves con
# `bash snowflake/setup/generate_keypair.sh` — ver snowflake/setup/README.md para el
# flujo completo (por qué key-pair y no password: evita el MFA obligatorio que Snowflake
# fuerza en cuentas nuevas para login interactivo).

# Snowsight -> ícono de perfil (abajo a la izquierda) -> "Account" -> "Account identifier".
# Formato típico: <organización>-<cuenta>, ej. ABCDEFG-XY12345
SNOWFLAKE_ACCOUNT=tu_identificador_de_cuenta

# Nombres fijados por snowflake/setup/ — no los cambies salvo que también hayas editado
# esos scripts.
SNOWFLAKE_USER=SVC_YELP_LOADER
SNOWFLAKE_WAREHOUSE=WH_YELP_XS
SNOWFLAKE_DATABASE=YELP_GOODYEAR_DW
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=YELP_LOADER_ROLE

# Ruta LOCAL (fuera del repo, o bajo snowflake/setup/keys/ que ya está en .gitignore) al
# archivo rsa_key.p8 generado por generate_keypair.sh. Cada integrante genera su propio
# par y usa su propia ruta — nunca se comparte el archivo .p8 por git.
SNOWFLAKE_PRIVATE_KEY_PATH=snowflake/setup/keys/rsa_key.p8

# Passphrase con la que se cifró rsa_key.p8 (la pediste al correr generate_keypair.sh).
# Déjala vacía solo si generaste la llave sin cifrar (no recomendado).
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
