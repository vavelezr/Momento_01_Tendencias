# Credenciales y configuración local — nunca se versionan
.env
flyway.conf

# Llaves RSA (key-pair auth de Snowflake) — la privada nunca se versiona
snowflake/setup/keys/
*.p8

# Entornos Python (uv)
.venv/
__pycache__/
*.pyc

# Artefactos generados por scripts de extracción/carga
data/output/

# dbt (Momento 3) — credenciales y artefactos generados, nunca versionados
dbt/profiles.yml
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml
